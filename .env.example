# Copy this file to .env and fill in the values.
#   copy .env.example .env
# Never commit .env. It holds your admin password and encryption keys.

# --- App login (single admin for now) ---
# You will type these on the sign-in page.
ADMIN_EMAIL=admin@leadfinder.local
# At least 8 characters. Change this before you import real lead files.
ADMIN_PASSWORD=change-me-now
# At least 32 random characters. Used to sign the login cookie.
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters

# --- Postgres ---
# Local Docker uses the line below. On Railway, leave this unset in the repo
# and set DATABASE_URL to the Postgres service variable ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://leadfinder:leadfinder@localhost:5433/leadfinder?schema=public

# --- Meilisearch (Docker) ---
# Must match MEILI_MASTER_KEY used by `docker compose up`.
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=leadfinder-dev-master-key-change-me

# --- Encryption ---
# Used later to encrypt the Google refresh token in the database.
# At least 32 characters.
ENCRYPTION_KEY=replace-with-another-random-string-at-least-32-characters

# --- Files ---
# Copies of imported workbooks are stored here so download and re-import
# still work if Drive is offline. Relative to the project folder.
STORAGE_PATH=./storage
# Largest workbook you can upload, in megabytes.
MAX_UPLOAD_MB=50

# --- Google Drive (online sync, connected in Phase 3) ---
# See README "Set up Google Drive access".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Optional. Only if a service account can see the shared folder.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_JSON=

# How often the app checks Drive while it is running, in minutes.
SYNC_INTERVAL_MINUTES=30
